# Copy to `.env` and edit. `.env` is gitignored — never commit it.
# deploy.sh sources this file and passes the values to the bundle + grants.
# The workspace/host is taken from your CLI profile (no host is committed).

# --- Databricks target ---
PROFILE=<your-cli-profile>       # CLI profile for the workspace that HAS the Marketplace dataset
TARGET=dev                       # bundle target in databricks.yml (dev | dogfood)

# --- Marketplace source dataset (probe target + ingest source) ---
# The catalog/schema the OpenSky data was installed under from Marketplace.
OPENSKY_CATALOG=marketplace
OPENSKY_SCHEMA=opensky

# --- SQL warehouse that runs the regeneration queries ---
OPENSKY_WAREHOUSE_ID=<your-sql-warehouse-id>

# --- UC volume where regenerated artifacts are stored (must be a WRITABLE catalog) ---
# Pick a catalog you can write to (some workspaces have `workspace` but no `main`).
VOL_CATALOG=<writable-catalog>
VOL_SCHEMA=opensky_vis
VOL_NAME=artifacts
# Must equal /Volumes/$VOL_CATALOG/$VOL_SCHEMA/$VOL_NAME
OPENSKY_VOLUME_ROOT=/Volumes/<writable-catalog>/opensky_vis/artifacts
