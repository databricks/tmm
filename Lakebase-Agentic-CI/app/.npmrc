# Keep the committed package-lock.json on the PUBLIC npm registry so
# GitHub-hosted CI (which cannot reach the internal npm-proxy.dev.databricks.com)
# can run `npm ci`. Developers behind the proxy still fetch through it — only
# the host recorded in the lockfile is normalized to registry.npmjs.org.
#
# Belt-and-suspenders: `npm run lockfile:fix` rewrites any stray internal-proxy
# URLs, and CI fast-fails if one slips through.
replace-registry-host=npmjs
